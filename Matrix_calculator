def matmul(A, B):
    n, m, k = len(A), len(B[0]), len(B)
    C = [[0]*m for _ in range(n)]
    for i in range(n):
        for j in range(m):
            for t in range(k):
                C[i][j] += A[i][t] * B[t][j]
    return C


def det(M):
    n = len(M)
    # 1x1
    if n == 1:
        return M[0][0]
    # 2x2
    if n == 2:
        return M[0][0]*M[1][1] - M[0][1]*M[1][0]

    # разложение по первой строке
    result = 0
    for j in range(n):
        # минор: убираем строку 0 и столбец j
        minor = [row[:j] + row[j+1:] for row in M[1:]]
        sign = 1 if j % 2 == 0 else -1
        result += sign * M[0][j] * det(minor)
    return result


def show(M):
    for row in M:
        print(row)
    print()


# ---------- УМНОЖЕНИЕ ----------

print("788:")
show(matmul([[3, -2], [5, -4]],
            [[3, 4], [2, 5]]))

print("790:")
show(matmul([[1, -3, 2], [3, -4, 1], [2, -5, 3]],
            [[2, 5, 6], [1, 2, 5], [1, 3, 2]]))

print("791:")
show(matmul([[5, 8, -4], [6, 9, -5], [4, 7, -3]],
            [[3, 2, 5], [4, -1, 3], [9, 6, 5]]))

print("792:")
show(matmul([[2, 1, 3, -4], [3, -2, 4, -3], [5, -3, -2, 1], [3, -3, -1, 2]],
            [[7, 8, 6, 9], [5, 7, 4, 5], [3, 4, 5, 6], [2, 1, 1, 2]]))


